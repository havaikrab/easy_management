# Комментарии записаны отдельными строками над переменными: значением считается все, что стоит после "=" в строке
# переменной (комментарий в той же строке стал бы частью значения).
# Переменные без значения ОБЯЗАТЕЛЬНО нужно заполнить, остальные уже содержат значения по умолчанию.

# Секретный код Django. ОБЯЗАТЕЛЬНО заполнить
SECRET_KEY=

# Флаг запуска в режиме разработки (True/False). Для продакшена оставить False
DEBUG=False

# Название местного часового пояса, например: Europe/Moscow
LOCAL_TIME_ZONE=UTC

# Автоматическое создание суперпользователя и первый запуск сервера
# Согласие на создание супер-пользователя при запуске или перезапуске сервера (True/False)
# ВАЖНО!!! При первом запуске с "пустой" базой данных необходимо указать True
# Супер-пользователь через админ-панель должен создать первые должности и выделить определенным должностям набор прав:
#  - "создавать и просматривать объекты модели Activity" - пользователи с данной должностью будут иметь полный доступ к эндпоинтам модели Activity и Employee
#  - "просматривать объекты модели Activity" - пользователи с данной должностью будут иметь возможность регистрировать новых сотрудников с присвоением им одной из существующих должностей
# После того, как в системе появятся сотрудники, имеющие вышеуказанные права супер-пользователь может быть удален ими же, а флаг CREATE_SUPER_ADMIN может быть исключен из переменных окружения
CREATE_SUPER_ADMIN=False
# Данные суперпользователя ОБЯЗАТЕЛЬНО заполнить при CREATE_SUPER_ADMIN=True
# Название должности нового супер-пользователя
SUPER_ADMIN_ACTIVITY=
# Системное имя-идентификатор нового супер-пользователя, максимальная длина - 12 символов. Нужно для входа в админ-панель
SUPER_ADMIN_NAME=
# Фамилия нового супер-пользователя
SUPER_LAST_NAME=
# Имя нового супер-пользователя
SUPER_FIRST_NAME=
# Отчество нового супер-пользователя, опционально
SUPER_FATHER_NAME=
# Пароль нового супер-пользователя
SUPER_PASSWORD=

# Параметры подключения к базе данных. DB_NAME, DB_USER и DB_PASSWORD ОБЯЗАТЕЛЬНО заполнить
DB_NAME=
DB_USER=
DB_PASSWORD=
# Порт, на котором БД docker-контейнера доступна с вашего компьютера (pgAdmin, psql, локальный запуск тестов).
# Внутри docker-сети приложение всегда подключается к порту 5432. Порт опубликован только в dev-конфигурации,
# в продакшене (deploy/docker-compose.yml) БД снаружи недоступна
DB_PORT=5432
# Хост БД. По умолчанию используется db (имя сервиса в docker compose). Нужен только при запуске приложения вне docker.
# НЕ УКАЗЫВАТЬ ДЛЯ ПРОДАКШЕНА!!!
# DB_HOST=localhost

# Параметры токенов JWT-авторизации
# Срок годности access-токена в минутах
ACCESS_TOKEN_LIFETIME=5
# Срок годности refresh-токена в сутках
REFRESH_TOKEN_LIFETIME=1

# Настройки Celery
# Флаг отслеживания выполнения задач (true/false)
CELERY_TASK_TRACK_STARTED=true
# Предел времени для обработки одной задачи в секундах
CELERY_TASK_TIME_LIMIT=600
# Уровень логирования Celery: DEBUG, INFO, WARNING, ERROR, CRITICAL
CELERY_LOG_LEVEL=INFO
# Интервал в минутах между проверками просроченных задач
CELERY_EXPIRED_STATUS_CHECK_INTERVAL=30

# Адреса Redis. Значения по умолчанию подходят для docker compose, раскомментируйте только при запуске вне docker
# CACHE_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/2
# CELERY_RESULT_BACKEND=redis://redis:6379/3

# Безопасность
# Списки разрешенных доменов через запятую, без пробелов. Укажите адрес, по которому пользователи открывают сервис,
# например: http://12.34.56.78,https://12.34.56.78,http://localhost,https://example.com
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost
CSRF_TRUSTED_ORIGINS=http://localhost,https://localhost
